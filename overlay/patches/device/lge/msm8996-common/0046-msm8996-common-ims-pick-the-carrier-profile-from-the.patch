diff --git a/ims/lge-ims-operator.rc b/ims/lge-ims-operator.rc
new file mode 100644
index 00000000..30334c4f
--- /dev/null
+++ b/ims/lge-ims-operator.rc
@@ -0,0 +1,12 @@
+# Set the LG IMS carrier profile preference as soon as the modem reports the SIM's network. Runs on
+# the property rather than at boot because gsm.sim.operator.numeric is empty until the SIM is read.
+# See lge-ims-operator.sh for why the profile choice decides the SIP security agreement.
+service lge_ims_operator /system/bin/lge-ims-operator.sh
+    class late_start
+    user system
+    group system
+    oneshot
+    disabled
+
+on property:gsm.sim.operator.numeric=*
+    start lge_ims_operator
diff --git a/ims/lge-ims-operator.sh b/ims/lge-ims-operator.sh
new file mode 100755
index 00000000..70aa3cf6
--- /dev/null
+++ b/ims/lge-ims-operator.sh
@@ -0,0 +1,52 @@
+#!/system/bin/sh
+# Pick the LG IMS carrier profile from the SIM instead of the device model.
+#
+# Stock ties the profile to the handset: com.lge.os.Build.CA_TARGET is VZW/US on a vs995, so a
+# Verizon profile is provisioned whatever SIM is present. That profile sets aos_reg_0_ipsec=false,
+# the REGISTER carries no Security-Client, and any P-CSCF that requires RFC 3329 answers
+# "421 Extension Required" and registration ends blocked. The profile matching the SIM's own network
+# sets aos_reg_0_ipsec=true, so the security agreement runs and REGISTER reaches 200 OK.
+#
+# OperatorInfo reads persist.lg.ims.pref_operator and persist.lg.ims.pref_country in its static
+# initialiser and prefers them over the model target, which is the stock override used here. The
+# properties persist, so a boot where the SIM is read after the app has already initialised still
+# leaves the right value in place for the next one.
+#
+# An unmapped SIM leaves both properties untouched, which keeps the stock target behaviour.
+
+MAP=/system/etc/ims/ims-operator-map.txt
+[ -r "$MAP" ] || exit 0
+
+# An explicit choice wins and keeps winning. Without this the mapping is re-asserted on every boot,
+# so a SIM the map gets wrong cannot be corrected on the device at all: setting the preference by
+# hand lasts until the next reboot and no further. Set persist.lg.ims.pref_locked to true and this
+# stops touching the preference, leaving whatever is there, including nothing.
+case "$(getprop persist.lg.ims.pref_locked)" in
+  1|true|TRUE|yes) exit 0 ;;
+esac
+
+# The SIM's own network, not whatever it is roaming on, and the only one of the two with an
+# SELinux label of its own (gsm.operator.numeric falls through to default_prop).
+mccmnc="$(getprop gsm.sim.operator.numeric)"
+case "$mccmnc" in
+  ''|*[!0-9]*) exit 0 ;;
+esac
+
+entry="$(while read -r code op country _rest; do
+    case "$code" in ''|\#*) continue ;; esac
+    [ "$code" = "$mccmnc" ] && { echo "$op $country"; break; }
+  done < "$MAP")"
+[ -n "$entry" ] || exit 0
+
+op="${entry%% *}"
+country="${entry##* }"
+[ -n "$op" ] && [ -n "$country" ] || exit 0
+
+# Writing the same value again would make the app re-provision lgims.db for nothing.
+[ "$(getprop persist.lg.ims.pref_operator)" = "$op" ] &&
+  [ "$(getprop persist.lg.ims.pref_country)" = "$country" ] && exit 0
+
+# Deliberately silent: `log` would need write_logd on this domain for a line that
+# `getprop persist.lg.ims.pref_operator` and `getprop net.ims.operator` already answer.
+setprop persist.lg.ims.pref_operator "$op"
+setprop persist.lg.ims.pref_country "$country"
