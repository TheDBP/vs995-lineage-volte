diff --git a/sepolicy/private/lge_ims_operator.te b/sepolicy/private/lge_ims_operator.te
new file mode 100644
index 00000000..e6de965f
--- /dev/null
+++ b/sepolicy/private/lge_ims_operator.te
@@ -0,0 +1,24 @@
+# Carrier profile selection (ims/lge-ims-operator.rc, ims/lge-ims-operator.sh). A oneshot shell
+# service started when the modem publishes the SIM's network. It reads the MCCMNC, looks it up in
+# /system/etc/ims/ims-operator-map.txt and sets the two preference properties OperatorInfo reads to
+# choose which carrier profile provisions lgims.db. That choice is what decides whether the SIP
+# REGISTER performs the RFC 3329 security agreement, so getting it wrong costs IMS entirely.
+type lge_ims_operator, domain, coredomain;
+type lge_ims_operator_exec, exec_type, file_type, system_file_type;
+init_daemon_domain(lge_ims_operator)
+
+# init execs the script, the kernel then execs the interpreter, and the script calls getprop and
+# setprop. /system/bin/sh is shell_exec, but getprop and setprop are symlinks to /system/bin/toybox,
+# which is toolbox_exec, so naming system_file alone leaves them denied. Symlink traversal and
+# directory search over system_file come from the domain.te baseline. rx_file_perms on system_file
+# covers reading the map in /system/etc/ims.
+allow lge_ims_operator shell_exec:file rx_file_perms;
+allow lge_ims_operator toolbox_exec:file rx_file_perms;
+allow lge_ims_operator system_file:file execute_no_trans;
+allow lge_ims_operator system_file:file rx_file_perms;
+
+# persist.lg.ims.pref_operator and persist.lg.ims.pref_country (property_contexts -> lge_ims_prop)
+set_prop(lge_ims_operator, lge_ims_prop)
+
+# gsm.sim.operator.numeric and gsm.operator.numeric
+get_prop(lge_ims_operator, telephony_status_prop)
